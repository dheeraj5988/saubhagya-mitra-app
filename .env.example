# Saubhagya — environment variables. Copy to .env (never commit real values).
# VITE_* values are baked into the browser bundle at BUILD time:
# set them before building and rebuild after changing them.

# ── Supabase (Dashboard → Project Settings → API) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── Admin panel (/admin) ───────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_PASSWORD_HINT=

# ── Site address ───────────────────────────────────────────────
SITE_URL=https://saubhagya.net
VITE_APP_URL=https://saubhagya.net

# ── Cloudflare R2 (Dashboard → R2 → Manage API tokens) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=saubhagya-order-files

# ── PhonePe (src/lib/phonepe.server.ts) ────────────────────────
PHONEPE_ENABLED=false
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Optional ───────────────────────────────────────────────────
# sha256 of the PC app's private key (only for /api/pc/pay-link, /api/pc/pay-status)
PC_SYNC_KEY_SHA256=
# Set by the host; the server listens on these (default 3000 / all interfaces)
PORT=3000
HOST=127.0.0.1
