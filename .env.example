# ┌──────────────────────────────────────────────────────────────┐
# │ Saubhagya Mitra App — Environment Variables                │
# │ Copy this file to .env and fill in the real values.        │
# │ NEVER commit real secrets — .env is .gitignored.           │
# └──────────────────────────────────────────────────────────────┘

# ── Server (process.env) ────────────────────────────────────────
# src/integrations/supabase/client.server.ts, src/lib/admin.server.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HINT=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ── Client (import.meta.env) ───────────────────────────────────
# Bundled into the browser — these are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── Supabase CLI only (Task 9) ─────────────────────────────────
# Not read by app code. Used for migrations and type generation.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# ── Public App URL & Health ─────────────────────────────────────
# Canonical production or preview URL for payment redirects and webhooks
VITE_APP_URL=https://saubhagya.net
# Secret key to authenticate calls to /api/health
HEALTH_KEY=

# ── Cloudflare R2 Fallback Storage ──────────────────────────────
# S3-compatible credentials for buffering fallback orders and backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── PC Bridge Sync (B9) ─────────────────────────────────────────
# SHA256 hash of the shared secret used in X-PC-Key header
PC_SYNC_KEY_SHA256=

# ── Anti-bot & Pipeline Limits ──────────────────────────────────
# Hold order threshold: maximum unpaid orders allowed from a single phone within 7 days
PIPELINE_MAX_UNPAID=5
# Hold order threshold: maximum awaiting orders allowed within 48 hours
PIPELINE_MAX_AWAITING=3

# ── PhonePe PG v2 ───────────────────────────────────────────────
# Enable PhonePe online payment flow (default: false)
PHONEPE_ENABLED=false
# Environment: SANDBOX or PRODUCTION
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Cashfree Gateway (Legacy/Alternative) ───────────────────────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ── WhatsApp / AiSensy Automation (B5, B6, B8, B10) ─────────────
# Enable automated WhatsApp notifications (default: false)
AISENSY_ENABLED=false
AISENSY_API_KEY=
