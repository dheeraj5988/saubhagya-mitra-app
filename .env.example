# ┌──────────────────────────────────────────────────────────────┐
# │ Saubhagya Mitra App — Environment Variables                │
# │ Copy this file to .env and fill in the real values.        │
# │ NEVER commit real secrets — .env is .gitignored.           │
# └──────────────────────────────────────────────────────────────┘

# ── Server (process.env) ────────────────────────────────────────
# src/integrations/supabase/client.server.ts, src/lib/admin.server.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HINT=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ── Client (import.meta.env) ───────────────────────────────────
# Bundled into the browser — these are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── Supabase CLI only (Task 9) ─────────────────────────────────
# Not read by app code. Used for migrations and type generation.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
