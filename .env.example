# ┌──────────────────────────────────────────────────────────────┐
# │ Saubhagya Mitra App — Environment Variables                │
# │ Copy this file to .env and fill in the real values.        │
# │ NEVER commit real secrets — .env is .gitignored.           │
# └──────────────────────────────────────────────────────────────┘

# ── Server (process.env) ────────────────────────────────────────
# src/integrations/supabase/client.server.ts, src/lib/admin.server.ts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HINT=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# ── Client (import.meta.env) ───────────────────────────────────
# Bundled into the browser — these are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── Supabase CLI only (Task 9) ─────────────────────────────────
# Not read by app code. Used for migrations and type generation.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your_sandbox_secret_key
CASHFREE_SECRET_KEY=your_sandbox_secret_key

# ── PhonePe Payment Gateway (server only; set these in Vercel) ───
# Read by src/lib/phonepe.server.ts. Never put real values in git.
PHONEPE_ENABLED=false
# SANDBOX for test keys, PRODUCTION for live keys
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
# Shown next to the keys in the PhonePe dashboard (usually 1)
PHONEPE_CLIENT_VERSION=1
# Optional: the username/password you set for the webhook in the PhonePe dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Optional: public address of the site (default https://saubhagya.net)
SITE_URL=
# Optional: sha256 of the PC app's private key, for /api/pc/pay-link and /api/pc/pay-status
PC_SYNC_KEY_SHA256=
